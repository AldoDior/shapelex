{
  "mcpServers": {
    "shapelex": {
      "command": "node",
      "args": ["./bin/shapelex-mcp.js"],
      "env": {
        "SHAPELEX_STORE_DIR": ".shapelex-claude",
        "SHAPELEX_MAX_STORE_MB": "100",
        "SHAPELEX_TOOLSET": "lean",
        "SHAPELEX_RESPONSE_MODE": "content-only"
      }
    }
  }
}
